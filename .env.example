# =============================================================================
# LinkedClone — environment configuration
#
# Local development:   cp .env.example .env   then set DEBUG=True
# On a server:         deploy/provision.sh writes /opt/linkedclone/shared/.env for you
#
# .env is never committed (see .gitignore). To change anything later on a
# server: edit /opt/linkedclone/shared/.env, then
#   sudo systemctl restart linkedclone
# No code change, redeploy or migration is needed for anything in this file.
# =============================================================================

# ---- Core -------------------------------------------------------------------
# True only on your own computer. Always False on the real server.
DEBUG=False

# Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Comma-separated domains the site answers to, e.g. example.com,www.example.com
ALLOWED_HOSTS=localhost,127.0.0.1

# Same domains with https://, e.g. https://example.com,https://www.example.com
# Login and every form fails with a "CSRF" error if this is wrong or empty.
CSRF_TRUSTED_ORIGINS=

# True = HTTPS only (redirects, secure cookies, HSTS). Set to False ONLY on a brand-new
# server during the short time before the certificate is issued; deploy/provision.sh
# does this for you and turns it back on when you run it with --tls.
HTTPS_ONLY=True

# Display time zone, e.g. America/Denver (default UTC)
TIME_ZONE=UTC

# ---- Database ---------------------------------------------------------------
# postgres://DB_USER:DB_PASSWORD@localhost:5432/DB_NAME
# Leave blank to use a local SQLite file (fine for trying it out on a laptop).
DATABASE_URL=
# Optional: where the SQLite file lives when DATABASE_URL is blank (provision.sh --sqlite
# sets this to a shared folder so deploys never lose data).
SQLITE_PATH=

# ---- Email (password-reset messages) ---------------------------------------
# Leave EMAIL_HOST_USER blank and emails are written to the service log
# (sudo journalctl -u linkedclone) instead of being sent. Any SMTP provider
# works (Brevo, Mailgun, SES, Gmail app password...).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=LinkedClone <no-reply@example.com>

# ---- IP location (optional) ----------------------------------------------------
# Lets country-based security rules and sign-in history show where an address is. Download the
# free database with:  sudo /opt/linkedclone/deploy-release.sh manage update_ip_location_db
# (about once a month). Without it everything works; country rules just never match.
IP_LOCATION_DB=

# ---- Logging ----------------------------------------------------------------
# WARNING (default), INFO or DEBUG
LOG_LEVEL=WARNING
